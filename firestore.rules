rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Stands ───────────────────────────────────────────────────
    match /stands/{standId} {
      // Lecture publique (clients et vendeurs)
      allow read: if true;

      // Création : tout utilisateur authentifié (autoCreate vendeur, admin)
      allow create: if request.auth != null;

      // Modification :
      //   1. Vendeur propriétaire (vendor_uid correspond)
      //   2. Google non-anonyme (admin) : peut tout faire SAUF écrire vendor_uid
      //      sur un stand déjà claimed (prévient le vol de stand).
      //      Exception : deleteField() sur vendor_uid est autorisé (déliaison admin).
      //   3. Client anonyme : champs EMA/file uniquement
      allow update: if request.auth != null && (
        // Propriétaire du stand
        request.auth.uid == resource.data.vendor_uid
        ||
        // Google non-anonyme : modifications libres sauf remplacement de vendor_uid sur stand claimed
        (request.auth.token.firebase.sign_in_provider != 'anonymous'
         && (
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['vendor_uid'])
           || resource.data.get('vendor_uid', '') == ''
           || !('vendor_uid' in request.resource.data)
         ))
        ||
        // Client anonyme : queue_counter, notes, EMA
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'queue_counter',
          'rating_count', 'rating_sum',
          'service_ms_ema', 'service_count', 'min_per_person'
        ])
      );

      // Suppression : vendeur propriétaire ou utilisateur Google (admin)
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';

      // ─── Historique ─────────────────────────────────────────────
      match /history/{entryId} {
        // Lecture : tout utilisateur Google authentifié (non-anonyme)
        // Le get() sur vendor_uid échoue si le champ est absent — on évite ce cas
        // en acceptant tout compte Google, ce qui suffit pour un MVP monovendeur.
        allow read: if request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';

        // Écriture : tout utilisateur authentifié (clients anonymes inclus)
        allow create: if request.auth != null;
      }
    }

    // ─── File d'attente ───────────────────────────────────────────
    match /queue/{userId} {
      // Lecture : tout utilisateur authentifié
      // (nécessaire pour les requêtes de comptage côté vendeur et client)
      allow read: if request.auth != null;

      // Création : son propre document, ou un compte Google (vendeur/admin, pour les outils dev)
      allow create: if request.auth != null && (
        request.auth.uid == userId
        || request.auth.token.firebase.sign_in_provider != 'anonymous'
      );

      // Mise à jour : le client (son propre doc) ou le vendeur du stand concerné
      allow update: if request.auth != null && (
        request.auth.uid == userId
        ||
        get(/databases/$(database)/documents/stands/$(resource.data.stand_id)).data.vendor_uid == request.auth.uid
      );

      // Suppression : le client supprime son propre doc (leave/done),
      // ou un compte Google (vendeur/admin — outils dev)
      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || request.auth.token.firebase.sign_in_provider != 'anonymous'
      );
    }
  }
}
